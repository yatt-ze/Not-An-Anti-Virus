<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<installer-gui-script minSpecVersion="1">
    <title>Example App</title>
    <options customize="allow" rootVolumeOnly="true"/>
    <script>
    function onConclusion() {
        system.run('unload.sh');
    }
    </script>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Example App" selected="system.compareVersions(system.version.ProductVersion, '10.9') &lt; 1">
        <pkg-ref id="invalid.example.navtest"/>
    </choice>
    <conclusion file="conclusion.html" onConclusionScript="onConclusion()"/>
    <pkg-ref id="invalid.example.navtest" version="1" installKBytes="1" updateKBytes="0">#component.pkg</pkg-ref>
    <pkg-ref id="invalid.example.navtest">
        <bundle-version/>
    </pkg-ref>
</installer-gui-script>